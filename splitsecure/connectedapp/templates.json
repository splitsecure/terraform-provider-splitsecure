							"parts": [
								{
									"field": {
										"name": "role_arn"
									}
								}
							]
						},
						"wrapInList": true
					},
					{
						"path": [
							"https://aws.amazon.com/source_identity"
						],
						"value": {
							"parts": [
								{
									"field": {
										"name": "source_identity"
									}
								}
							]
						}
					},
					{
						"path": [
							"https://aws.amazon.com/tags",
							"principal_tags",
							"SplitSecureTokenId"
						],
						"value": {
							"parts": [
								{
									"field": {
										"name": "token_id"
									}
								}
							]
						},
						"wrapInList": true
					}
				],
				"requestedClientDuration": {
					"name": "session_duration"
				}
			},
			"each": [
				{
					"field": "session_tag",
					"pathPrefix": [
						"https://aws.amazon.com/tags",
						"principal_tags"
					],
					"wrapInList": true
				}
			]
