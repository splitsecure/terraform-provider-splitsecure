# Copy to terraform.tfvars (gitignored) and fill in your s2r URIs --
# match the format your existing team / org URIs use.

org_s2r              = "s2r:<deployment>:org:<org_id>"
engineering_team_s2r = "s2r:<deployment>:team:<engineering_team_id>"
support_team_s2r     = "s2r:<deployment>:team:<technical_support_team_id>"
